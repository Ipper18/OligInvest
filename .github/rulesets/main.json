{
  "name": "main",
  "target": "branch",
  "enforcement": "disabled",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "build (all)"
          },
          {
            "context": "build (without admin)"
          },
          {
            "context": "build (without alerts)"
          },
          {
            "context": "build (without analytics)"
          },
          {
            "context": "build (without education)"
          },
          {
            "context": "build (without quick-actions)"
          },
          {
            "context": "contracts"
          },
          {
            "context": "db"
          },
          {
            "context": "deps-audit"
          },
          {
            "context": "e2e"
          },
          {
            "context": "lint"
          },
          {
            "context": "modules"
          },
          {
            "context": "repository"
          },
          {
            "context": "typecheck"
          },
          {
            "context": "unit"
          },
          {
            "context": "web"
          },
          {
            "context": "workers"
          }
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "alerts_threshold": "errors",
            "security_alerts_threshold": "high_or_higher"
          }
        ]
      }
    }
  ]
}
