{
  "name": "oliginvest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:test": "node scripts/dev.mjs --check",
    "queues:test": "node apps/jobs/scripts/test-queues.mjs",
    "db:seed:test": "node packages/db/scripts/test-seed.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "check:repository": "node scripts/check-repository.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "lint:openapi": "redocly lint --format=summary",
    "gen:api-client": "pnpm --filter @oliginvest/openapi-client generate",
    "check:api-client": "pnpm --filter @oliginvest/openapi-client check",
    "check:contracts": "pnpm lint:openapi && pnpm turbo run build --filter=@oliginvest/api --output-logs=new-only && pnpm --filter @oliginvest/api exec vitest run test/openapi.test.mjs --reporter=dot && node apps/api/scripts/openapi.mjs check",
    "gen:openapi-pending": "pnpm turbo run build --filter=@oliginvest/api --output-logs=new-only && node apps/api/scripts/openapi.mjs pending",
    "gen:module": "node scripts/gen-module.mjs",
    "test:module-generator": "node scripts/test-module-generator.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "db:generate": "pnpm turbo run build --filter=\"./modules/*\" && pnpm --dir packages/db exec drizzle-kit generate",
    "db:test": "node packages/db/scripts/test-database.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@redocly/cli": "2.54.2",
    "@vitest/coverage-v8": "5.0.1",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
