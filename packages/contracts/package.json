{
  "name": "@oliginvest/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "gen:analytics-schema": "node scripts/analytics-schema.mjs write",
    "check:analytics-schema": "node scripts/analytics-schema.mjs check"
  },
  "exports": {
    "./realtime/browser": {
      "types": "./dist/realtime-schemas.d.ts",
      "import": "./dist/realtime-schemas.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js"
    },
    "./analytics-jobs": {
      "types": "./dist/analytics-jobs.d.ts",
      "import": "./dist/analytics-jobs.js"
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
