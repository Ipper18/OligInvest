{
  "name": "@oliginvest/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check . && node ../../scripts/check-ui-text.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "exports": {
    "./education": {
      "types": "./dist/education.d.ts",
      "import": "./dist/education.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legal": {
      "types": "./dist/legal.d.ts",
      "import": "./dist/legal.js"
    }
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
