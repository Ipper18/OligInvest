{
  "name": "@oliginvest/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check . && node ../../scripts/check-ui-text.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "exports": {
    "./onboarding": {
      "types": "./dist/onboarding.d.ts",
      "import": "./dist/onboarding.js"
    },
    "./allocation": {
      "types": "./dist/allocation.d.ts",
      "import": "./dist/allocation.js"
    },
    "./privacy": {
      "types": "./dist/privacy.d.ts",
      "import": "./dist/privacy.js"
    },
    "./education": {
      "types": "./dist/education.d.ts",
      "import": "./dist/education.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legal": {
      "types": "./dist/legal.d.ts",
      "import": "./dist/legal.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    },
    "./en": {
      "types": "./dist/en.d.ts",
      "import": "./dist/en.js"
    },
    "./preferences": {
      "types": "./dist/preferences.d.ts",
      "import": "./dist/preferences.js"
    },
    "./education-content-en": {
      "types": "./dist/education-content-en.d.ts",
      "import": "./dist/education-content-en.js"
    },
    "./onboarding-en": {
      "types": "./dist/onboarding-en.d.ts",
      "import": "./dist/onboarding-en.js"
    },
    "./pwa-en": {
      "types": "./dist/pwa-en.d.ts",
      "import": "./dist/pwa-en.js"
    }
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
