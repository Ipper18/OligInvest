# OligInvest — przykładowe zmienne środowiskowe.
# Skopiuj do `.env` (ignorowany przez git) i uzupełnij. NIGDY nie commituj prawdziwych kluczy.
#
# Sekcja A: klucze używane przez serwery MCP z `.mcp.json` (środowisko deweloperskie Claude Code).
# Sekcja B: zmienne runtime aplikacji (docs/07-wdrozenie/infrastruktura.md § 8). W produkcji sekrety są plikami
#           w /etc/oliginvest/secrets/ montowanymi do kontenerów (zmienne *_FILE); wartości wprost tylko lokalnie.
# Sekcja C: kopie zapasowe na hoście VM (docs/07-wdrozenie/backup-dr.md) — nie trafiają do kontenerów aplikacji.

# ---------- A. MCP (Claude Code) ----------

# Context7 — dokumentacja bibliotek. Działa anonimowo; klucz podnosi limity.
# https://context7.com/dashboard
CONTEXT7_API_KEY=

# GitHub MCP (api.githubcopilot.com). Fine-grained PAT z minimalnym zakresem (repo: read/write tylko dla OligInvest).
# https://github.com/settings/personal-access-tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Alpha Vantage — oficjalny zdalny MCP; darmowy klucz (limit dobowy — patrz docs/03-dane/zrodla-danych.md).
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Twelve Data MCP (https://mcp.twelvedata.com/mcp) loguje się przez przeglądarkę (OAuth) — klucz nie jest potrzebny w env.

# ---------- B. Aplikacja (runtime) ----------

# Konfiguracja (nie sekrety, ale wartości instancji — też poza repozytorium)
PUBLIC_BASE_URL=
API_INTERNAL_URL=
ACME_EMAIL=
VPS_TUNNEL_IP=
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=

# Uwierzytelnianie i platforma (BETTER_AUTH_SECRETS = wersjonowana lista sekretów Better Auth)
BETTER_AUTH_SECRETS=
AUDIT_PSEUDONYM_KEY=

# PostgreSQL — osobne hasło dla każdej roli (docs/03-dane/schema.sql § 0)
DB_OWNER_PASSWORD=
DB_AUTH_PASSWORD=
DB_APP_PASSWORD=
DB_ANALYTICS_RO_PASSWORD=
DB_BACKUP_PASSWORD=

# Valkey — użytkownicy ACL per usługa i instancja
VALKEY_QUEUE_API_PASSWORD=
VALKEY_QUEUE_JOBS_PASSWORD=
VALKEY_QUEUE_ANALYTICS_PASSWORD=
VALKEY_CACHE_API_PASSWORD=
VALKEY_CACHE_JOBS_PASSWORD=

# Powiadomienia
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Dostawcy danych (NBP, archiwum GPW i Yahoo bez klucza; brak klucza = adapter wyłączony).
# ALPHAVANTAGE_API_KEY z sekcji A służy także adapterowi aplikacji.
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
FRED_API_KEY=
MARKETAUX_API_KEY=

# OAuth (P2, flaga auth.oauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- C. Kopie zapasowe (host VM) ----------

PGBACKREST_REPO1_CIPHER_PASS=
RESTIC_PASSWORD=
RESTIC_REST_USERNAME=
RESTIC_REST_PASSWORD=

# ---------- D. Samodzielne compose.dev.yaml (tylko lokalnie, dane syntetyczne) ----------
# DEV_BIND_ADDRESS: adres pętli zwrotnej hosta; instrukcja bez adresów instancji:
# docs/07-wdrozenie/srodowisko-deweloperskie.md. Brak wartości blokuje start Compose.
# Poniższe hasła są osobne od wszystkich poświadczeń aplikacji i produkcji.
DEV_BIND_ADDRESS=
DEV_POSTGRES_PASSWORD=
DEV_VALKEY_QUEUE_PASSWORD=
DEV_VALKEY_CACHE_PASSWORD=
# Opcjonalne porty lokalne; puste wartości wybierają domyślne porty z Compose.
DEV_POSTGRES_PORT=
DEV_VALKEY_QUEUE_PORT=
DEV_VALKEY_CACHE_PORT=
DEV_SMTP_PORT=
DEV_MAILPIT_UI_PORT=
