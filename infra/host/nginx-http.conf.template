# Include inside http {}. Port 80 never forwards requests to an application.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    listen [::]:80;
    server_name <PUBLIC_HOST> <IMMICH_HOST>;
    location = /api { return 403; }
    location ^~ /api/ { return 403; }
    location / { return 301 https://$host$request_uri; }
}
