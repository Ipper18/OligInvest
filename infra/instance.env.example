# Copy outside the repository to /etc/oliginvest/instance.env, owned by root (0600).
PUBLIC_BASE_URL=https://<PUBLIC_HOST>
HTTPS_BIND_ADDRESS=<VM_BIND_ADDRESS>
HTTPS_PORT=<HTTPS_PORT>
VPS_TUNNEL_CIDR=<TRUSTED_TUNNEL_CIDR>
ACME_EMAIL=<ACME_EMAIL>
CADDY_ADMIN_URL=http://<CONTAINER_IPV4_LOOPBACK>:2019/config/
