      "default": "./dist/src/ui/index.js"
    }
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "@oliginvest/mod-identity": "workspace:*",
    "@oliginvest/data-providers": "workspace:*",
    "@oliginvest/core": "workspace:*",
    "@oliginvest/db": "workspace:*",
    "@oliginvest/platform": "workspace:*",
    "@oliginvest/contracts": "workspace:*",
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.5"
  }
